maplibre:
  remote: https://unpkg.com
  version: 2.4.0
  license:
    name: BSD-3-Clause
    url: https://github.com/maplibre/maplibre-gl-js/blob/main/LICENSE.txt
    gpl-compatible: true
  css:
    theme:
      https://unpkg.com/maplibre-gl@2.4.0/dist/maplibre-gl.css: { type: external }
  js:
    https://unpkg.com/maplibre-gl@2.4.0/dist/maplibre-gl.js: { type: external }

leaflet:
  remote: https://unpkg.com
  version: 1.9.4
  license:
    name: BSD-2-Clause
    url: https://github.com/Leaflet/Leaflet/blob/main/LICENSE
    gpl-compatible: true
  css:
    theme:
      https://unpkg.com/leaflet@1.9.4/dist/leaflet.css: { type: external }
  js:
    https://unpkg.com/leaflet@1.9.4/dist/leaflet.js: { type: external }

sailbuddy_map.init:
  css:
    theme:
      css/sailbuddy_map.css: {}
  js:
    js/sailbuddy_map.js: {}
  dependencies:
    - sailbuddy_map/maplibre
    - sailbuddy_map/leaflet

sailbuddy_map.overlays:
  js:
    js/sailbuddy-map-overlays.js: {}
  dependencies:
    - leaflet/leaflet-drupal
    - core/drupalSettings
    - core/once
leaflet-velocity:
  remote: https://unpkg.com/leaflet-velocity@2.1.4
  version: 2.1.4
  license:
    name: MIT
    url: https://github.com/onaci/leaflet-velocity/blob/master/LICENSE
    gpl-compatible: true
  js:
    js/vendor/leaflet-velocity.js: { minified: true }
