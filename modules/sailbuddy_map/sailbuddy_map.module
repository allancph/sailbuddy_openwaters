<?php

/**
 * @file
 * Sailbuddy Map module hooks.
 */

use Drupal\Core\Url;

/**
 * Implements hook_theme().
 */
function sailbuddy_map_theme($existing, $type, $theme, $path) {
  return [
    'sailbuddy_map' => [
      'variables' => [
        'map_id' => NULL,
        'height' => '500px',
        'attributes' => [],
      ],
      'template' => 'sailbuddy-map',
    ],
  ];
}

/**
 * Implements hook_leaflet_map_info().
 *
 * Registers the OpenWaters Seamap chart as a Leaflet base map. Uses Leaflet's
 * built-in vector support (L.maplibreGL) so no custom renderer is needed.
 * The style is served sanitized by our own controller (strip paints the
 * bundled MapLibre version cannot parse, e.g. paint.resampling).
 */
function sailbuddy_map_leaflet_map_info() {
  $default_settings = [
    'attributionControl' => TRUE,
    'closePopupOnClick' => TRUE,
    'doubleClickZoom' => TRUE,
    'dragging' => TRUE,
    'fadeAnimation' => TRUE,
    'layerControl' => TRUE,
    'layerControlOptions' => [
      'position' => 'topleft',
      'collapsed' => FALSE,
    ],
    'maxZoom' => 19,
    'minZoom' => 0,
    'scrollWheelZoom' => TRUE,
    'touchZoom' => TRUE,
    'trackResize' => TRUE,
    'zoomAnimation' => TRUE,
    'zoomControl' => TRUE,
  ];

  $map_info['openwaters_seamap'] = [
    'label' => 'OpenWaters Seamap (nautical chart + bathymetry)',
    'description' => t('OpenWaters nautical chart with bathymetry, rendered through the Leaflet module\'s MapLibre GL integration.'),
    'settings' => $default_settings + [
      'zoom' => 8,
    ],
    'layers' => [
      'OpenWaters Seamap' => [
        'type' => 'vector',
        'urlTemplate' => Url::fromRoute('sailbuddy_map.style', ['chart' => 'seamap'])->toString(),
        'options' => [
          'attribution' => '© <a href="https://openwaters.io">OpenWaters</a> Seamap · © OpenStreetMap contributors',
        ],
      ],
      'Satellit (Esri World Imagery)' => [
        'type' => 'raster',
        'urlTemplate' => 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
        'options' => [
          'attribution' => '© Esri, Maxar, Earthstar Geographics, and the GIS User Community',
        ],
      ],
    ],
  ];

  return $map_info;
}

/**
 * Implements hook_preprocess_leaflet_map().
 *
 * Attaches the AIS overlay + tide prediction library and global settings
 * to every Leaflet map rendered on a page.
 */
function sailbuddy_map_preprocess_leaflet_map(array &$variables) {
  $config = \Drupal::config('sailbuddy_map.settings');

  // Wind overlay reuses the tile layer previously defined for the old
  // sailbuddy.com (leaflet_layers config) so the source stays the existing
  // one ("vinden kommer fra en anden kilde").
  $wind_tiles = NULL;
  $wind_config = \Drupal::config('leaflet_layers.map_layer.openwxwind')->get('settings.urlTemplate');
  if (!empty($wind_config)) {
    $wind_tiles = $wind_config;
  }

  $variables['#attached']['library'][] = 'sailbuddy_map/sailbuddy_map.overlays';
  $variables['#attached']['drupalSettings']['sailbuddy_map_overlays'] = [
    'enable_ais'      => (bool) $config->get('enable_ais'),
    'ais_refresh'     => (int) $config->get('ais_refresh') ?: 30,
    'enable_tides'    => (bool) $config->get('enable_tides'),
    'tides_units'     => $config->get('tides_units') ?: 'm',
    'ais_api'         => 'https://ais.openwaters.io/v1/vessels',
    'tide_api'        => 'https://api.openwaters.io/tides/extremes',
    'tide_stations'   => 'https://api.openwaters.io/tides/stations',
    'wind_tiles'      => $wind_tiles,
    'wind_particles'  => TRUE,
    'wind_particles_url' => \Drupal\Core\Url::fromRoute("openmeteo_weather.wind_grid", [], ['language' => \Drupal::languageManager()->getLanguage('en')])->setAbsolute(TRUE)->toString(),
    'wind_particles_url_eu' => \Drupal\Core\Url::fromRoute("openmeteo_weather.wind_grid_eu", [], ['language' => \Drupal::languageManager()->getLanguage('en')])->setAbsolute(TRUE)->toString(),
    'mapillary' => [
      'enable' => (bool) ($config->get('enable_mapillary') ?? TRUE),
      'photos' => \Drupal\Core\Url::fromRoute("sailbuddy_map.mapillary_photos", [], ['language' => \Drupal::languageManager()->getLanguage('en')])->setAbsolute(TRUE)->toString(),
    ],
  ];
}